<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= username %>'s Game History</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        .history-card {
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .history-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 15px rgba(0, 0, 0, 0.2);
        }
    </style>
</head>

<body class="bg-gradient-to-br from-zinc-900 to-zinc-800 text-white min-h-screen font-sans p-6">
    <div class="max-w-4xl mx-auto">
        <h1 class="text-4xl font-bold mb-8 text-center">
            Game History for <span class="text-green-400"><%= username %></span>
        </h1>

        <% if (history.length === 0) { %>
            <p class="text-center text-zinc-400">No games found yet.</p>
        <% } else { %>
            <div class="space-y-6">
                <% history.forEach(game => {
                    const opponent = game.player1Name === username ? game.player2Name : game.player1Name;
                    const isWinner = game.winnerName === username;
                %>
                    <div class="bg-zinc-900 rounded-xl p-6 history-card">
                        <div class="flex items-center justify-between mb-4">
                            <div class="flex items-center space-x-2">
                                <% if (game.result === 'draw') { %>
                                    <span class="text-yellow-500 text-2xl">🤝</span>
                                    <p class="text-lg font-semibold text-yellow-400">Draw</p>
                                <% } else if (isWinner) { %>
                                    <span class="text-green-500 text-2xl">🎉</span>
                                    <p class="text-lg font-semibold text-green-400">Win</p>
                                <% } else { %>
                                    <span class="text-red-500 text-2xl">😞</span>
                                    <p class="text-lg font-semibold text-red-400">Loss</p>
                                <% } %>
                            </div>
                            <p class="text-sm text-zinc-500">
                                <%= new Date(game.date).toLocaleDateString() %> at 
                                <%= new Date(game.date).toLocaleTimeString() %>
                            </p>
                        </div>

                        <div class="mb-4">
                            <p class="text-zinc-400 text-sm">
                                Opponent: <span class="text-white font-medium"><%= opponent %></span>
                            </p>
                        </div>

                        <div class="bg-zinc-800 rounded-lg p-4 max-h-40 overflow-y-auto">
                            <p class="text-zinc-400 text-sm mb-2">Moves:</p>
                            <div class="grid grid-cols-[30px_1fr_1fr] gap-x-4 gap-y-1 text-sm">
                                <div class="text-zinc-500 font-semibold">#</div>
                                <div class="text-white font-semibold">White</div>
                                <div class="text-white font-semibold">Black</div>

                                <% for (let i = 0; i < game.moves.length; i += 2) { %>
                                    <div class="text-zinc-500"><%= Math.floor(i / 2) + 1 %>.</div>
                                    <div><%= game.moves[i] %></div>
                                    <div><%= game.moves[i + 1] || '' %></div>
                                <% } %>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } %>
    </div>
</body>

</html>
